# Database
# For Vercel, use PostgreSQL with Prisma Accelerate or Vercel Postgres
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NODE_ENV="production"

# Authentication (if using next-auth)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Feedback form (server-side secret — NOT exposed to browser)
# POST /api/feedback proxies to this endpoint
FORMSPREE_ENDPOINT="https://formspree.io/f/your-form-id"

# Comma-separated list of allowed origins for the feedback proxy
ALLOWED_ORIGINS="https://your-domain.vercel.app,http://localhost:3000"
